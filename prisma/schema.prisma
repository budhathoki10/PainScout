// Pain Scout — data model
// MongoDB via Prisma. Requires DATABASE_URL (MongoDB connection string) to migrate/run.
// See lib/prisma.ts for why this is safe to leave unconfigured in the demo build.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum DigestFrequency {
  DAILY
  TWICE_DAILY
}

enum LeadStatus {
  NEW
  USEFUL
  NOT_RELEVANT
  CONTACTED
}

enum PlanTier {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  timezone      String    @default("UTC")
  emailDigestOn Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  projects     Project[]
  subscription Subscription?
}

// Auth.js (NextAuth) Prisma adapter model — links OAuth accounts (Google) to a User.
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Project {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  userId        String           @db.ObjectId
  name          String
  keywords      String[]
  frequency     DigestFrequency  @default(DAILY)
  deliveryHour  Int              @default(8)
  paused        Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads      Lead[]
  digestLogs DigestLog[]

  @@index([userId])
}

model Lead {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  projectId    String     @db.ObjectId
  postUri      String
  authorHandle String
  text         String
  url          String
  score        Float
  status       LeadStatus @default(NEW)
  matchedOn    String[]
  createdAt    DateTime   @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Deduplication: a given Bluesky post is only ever stored once per project.
  @@unique([projectId, postUri])
  @@index([projectId, createdAt])
}

enum DigestSource {
  CRON
  MANUAL
}

model DigestLog {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  projectId String       @db.ObjectId
  sentAt    DateTime     @default(now())
  leadCount Int
  opened    Boolean      @default(false)
  // CRON = scheduled digest (may have emailed); MANUAL = a "Scrape now"
  // click (never emails). Both count toward a plan's daily scan budget
  // (lib/plan-limits.ts), but only CRON rows gate the cron route's own
  // "already ran this delivery window" guard — a manual scrape shouldn't
  // block the scheduled run for that slot from firing.
  source    DigestSource @default(CRON)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sentAt])
}

model Subscription {
  id     String             @id @default(auto()) @map("_id") @db.ObjectId
  userId String             @unique @db.ObjectId
  plan   PlanTier           @default(FREE)
  // Webhook-driven label only — NOT what gates access. See lib/entitlements.ts:
  // access is decided live by comparing currentPeriodEnd against now, since
  // Freemius does not reliably fire a webhook exactly when a period lapses
  // (e.g. a silently failed renewal). status still matters for
  // ACTIVE/PAST_DUE vs CANCELED, just not for the time bound.
  status SubscriptionStatus @default(ACTIVE)

  // Freemius's own license id — the stable key renewal/cancellation/expiry
  // webhooks are matched against, instead of re-resolving by email every time.
  // Not a DB-level unique constraint (Mongo unique indexes reject multiple
  // nulls, and every pre-Freemius Subscription row has none) — matching code
  // in lib/billing-freemius.ts already resolves by userId either way.
  fsLicenseId            String?
  freemiusUserId         String?
  freemiusSubscriptionId String?
  // Set once, at first successful purchase, never overwritten on renewal —
  // "subscriber since," not "current billing cycle start."
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  canceledAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fsLicenseId])
}

// Freemius webhook replay guard: the SDK verifies signatures but doesn't
// stop the same event being delivered twice (a genuine retry, or a captured
// payload replayed by an attacker) — claims eventId exactly once via the
// unique [provider, eventId] index below.
model WebhookEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  provider  String
  eventId   String
  eventType String?
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
}
